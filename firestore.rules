rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own contacts
    match /users/{uid}/contacts/{contactId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Each user can only read/write their own settings
    match /users/{uid}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Notification records — owner only
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
